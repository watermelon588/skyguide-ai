# SkyGuide AI — excluded from any Vercel / Netlify style static deployment.
# The frontend is the only thing that belongs in a static deploy; everything
# below is either a secret, internal-only, or a backend service.

.env
.env.*
!.env.example
**/.env
**/.env.*

_local/
.claude/
CLAUDE.md

.git
.runtime/
docs/

server-gateway/
astro-engine/
# Anchored to repo root (leading slash) so the frontend's own scripts/ —
# which holds the prebuild sync-brand.mjs — is NOT stripped from the deploy.
/scripts/

**/__pycache__/
*.py[cod]
venv/
.venv/
*.log
