# SkyGuide AI — Express Gateway environment
# Copy to `.env` and fill in real secrets + your LAN IP / tunnel URLs.

PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=your-mongodb-atlas-uri

# Auth
JWT_SECRET=your-jwt-secret

# FastAPI Astro Engine (server-to-server)
FASTAPI_URL=http://localhost:8000

# Shared secret proving a request came from this gateway. MUST match the astro
# engine's INTERNAL_API_KEY. Required in production — the engine refuses to
# start without one, since it would otherwise be an open compute API.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# Email (Nodemailer)
EMAIL_USER=your-email
EMAIL_PASS=your-app-password

# AI (Groq)
GROQ_API_KEY=your-groq-key
# Optional. Defaults to openai/gpt-oss-20b.
GROQ_MODEL=

# ─────────────────────────────────────────────────────────────
# Image storage (community gallery)
# Set these to persist uploads on Cloudinary's CDN — REQUIRED on a stateless
# host (Render/Railway/Vercel), whose local disk is wiped on every redeploy.
# Leave ALL blank to fall back to local-disk storage (fine for dev).
# Use EITHER the single URL form, OR the three discrete vars below it.
# ─────────────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────────────────
# Network mode: local | lan | tunnel   (production reserved)
# CORS allows every URL below regardless of mode (never a wildcard).
# ─────────────────────────────────────────────────────────────
NETWORK_MODE=local
LOCAL_CLIENT_URL=http://localhost:5173
LAN_CLIENT_URL=http://192.168.1.15:5173
TUNNEL_CLIENT_URL=https://your-subdomain.trycloudflare.com

# Legacy / extra allowed origins (comma-separated). Merged into CORS allow-list.
CLIENT_URL=http://localhost:5173
